              "raw": "{{baseUrl}}/api/coach/chat/message",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coach", "chat", "message"]
            },
            "description": "Send a message with a file attachment.\n\n**fileType options:** `IMAGE`, `VIDEO`, `FILE`, `AUDIO`"
          }
        },
